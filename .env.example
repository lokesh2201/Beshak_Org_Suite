# Health proposal link ID: /insurance/forms/proposal/<ID>/
HEALTH_PROPOSAL_ID=85c6ca77-0ec2-47f2-a5b3-933805c399aa

# Proposal verify API used by TC-HF09
PROPOSAL_API_URL=https://vision.beshak.org/api/marketplace/proposals/verify_proposal_link

# Keep low: tests run against production
WORKERS=2

# Block analytics/ad trackers during runs (true/false)
BLOCK_TRACKERS=true
